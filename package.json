{
  "name": "getway-de-pagamento",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @getway/api\" \"npm run dev -w @getway/web\"",
    "build": "npm run build -w @getway/api && npm run build -w @getway/web",
    "db:generate": "npm run db:generate -w @getway/api",
    "db:migrate": "npm run db:migrate -w @getway/api",
    "db:seed": "npm run db:seed -w @getway/api"
  },
  "devDependencies": {"concurrently": "^9.1.2"}
}
