generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { OWNER ADMIN ANALYST }
enum BillingType { PIX BOLETO CREDIT_CARD UNDEFINED }
enum PaymentStatus { PENDING CONFIRMED RECEIVED OVERDUE REFUNDED CANCELLED FAILED }
enum LedgerType { CREDIT DEBIT FEE REFUND }
enum SubscriptionStatus { ACTIVE PAUSED CANCELLED }

model Tenant {
  id String @id @default(cuid())
  name String
  document String?
  providerCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  customers Customer[]
  payments Payment[]
  ledger LedgerEntry[]
  subscriptions Subscription[]
  paymentLinks PaymentLink[]
  transfers Transfer[]
}

model User {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  email String @unique
  passwordHash String
  role UserRole @default(OWNER)
  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId String?
  name String
  email String?
  phone String?
  document String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  subscriptions Subscription[]
  @@index([tenantId])
}

model Payment {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerId String? @unique
  externalReference String?
  description String?
  billingType BillingType
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14,2)
  fee Decimal @default(0) @db.Decimal(14,2)
  netAmount Decimal @default(0) @db.Decimal(14,2)
  dueDate DateTime
  invoiceUrl String?
  bankSlipUrl String?
  pixPayload String?
  pixEncodedImage String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ledger LedgerEntry[]
  @@index([tenantId, status])
  @@index([customerId])
}

model LedgerEntry {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId String?
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type LedgerType
  amount Decimal @db.Decimal(14,2)
  description String
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model Subscription {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId String?
  description String?
  billingType BillingType
  amount Decimal @db.Decimal(14,2)
  cycle String @default("MONTHLY")
  nextDueDate DateTime
  status SubscriptionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id String @id
  provider String
  event String
  payload Json
  processedAt DateTime @default(now())
}

model PaymentLink {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId String? @unique
  name String
  description String?
  billingType BillingType
  chargeType String @default("DETACHED")
  value Decimal? @db.Decimal(14,2)
  url String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, active])
}

model Transfer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId String? @unique
  amount Decimal @db.Decimal(14,2)
  pixAddressKey String
  pixAddressKeyType String?
  status String @default("PENDING")
  externalReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, createdAt])
}
